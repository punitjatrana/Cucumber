<!-- Source: https://mvnrepository.com/artifact/commons-io/commons-io -->
<!-- This dependency is used for screenshot image -->
<dependency>
    <groupId>commons-io</groupId>
    <artifactId>commons-io</artifactId>
    <version>2.22.0</version>
